# Harness Mate 单机 Compose 环境变量模板
# 复制为 .env 后填写。连接串主机名保持 postgres / redis，不要写成 IP。
# 公网部署建议 FLASK_ENV=production、FLASK_DEBUG=0，entrypoint 才会走 gunicorn。

# Flask基础配置
FLASK_DEBUG=1
FLASK_ENV=development

# jwt加密秘钥
JWT_SECRET_KEY=change-me

# wtf配置
WTF_CSRF_ENABLED=False

# SQLAlchemy数据库配置
SQLALCHEMY_DATABASE_URI=postgresql://postgres:change-me@postgres:5432/your_db?client_encoding=utf8
SQLALCHEMY_POOL_SIZE=30
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_ECHO=True

# Redis数据库配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=change-me
REDIS_DB=0
REDIS_USE_SSL=False

# Github OAuth应用秘钥
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://harness.alltman.com/auth/authorize/github

# 腾讯云COS对象存储
COS_SECRET_ID=change-me
COS_SECRET_KEY=change-me
COS_REGION=ap-guangzhou
COS_SCHEME=https
COS_BUCKET=your-bucket
COS_DOMAIN=

# 注册验证码邮件
MAIL_HOST=smtp.126.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=change-me
MAIL_DEFAULT_SENDER=you@example.com
MAIL_SENDER_NAME=Harness Mate

# 部署项（entrypoint / gunicorn）
MIGRATION_ENABLED=true
MODE=api
SERVER_WORKER_AMOUNT=4
SERVER_THREAD_AMOUNT=4
GUNICORN_TIMEOUT=600

# postgres（口令、库名与 SQLALCHEMY_DATABASE_URI 保持一致）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=your_db
PGDATA=/var/lib/postgresql/data/pgdata

# nginx / certbot
DOMAIN=harness.alltman.com
CERTBOT_EMAIL=you@example.com
